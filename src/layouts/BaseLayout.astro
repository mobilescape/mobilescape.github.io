---
const { title = 'CHOI JUNYONG', description = 'Urban data, artificial intelligence, and urban mobility' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <a class="brand" href="/">CHOI JUNYONG</a>
      <nav aria-label="Primary navigation">
        <a href="/about/">About</a>
        <a href="/research/">Research</a>
        <a href="/teaching/">Teaching</a>
        <a href="/publications/">Publications</a>
        <a href="/mobilescape/">Mobilescape</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>단국대학교 도시계획부동산학부</p>
      <p>Dankook University, School of Urban Planning and Real Estate</p>
    </footer>
  </body>
</html>

<style is:global>
  :root { --ink: #18212f; --muted: #687386; --line: #e7eaf0; --blue: #3156d3; --paper: #f8f9fc; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: #fff; font-family: Inter, "Pretendard", "Noto Sans KR", sans-serif; }
  a { color: inherit; text-decoration: none; }
  .header { max-width: 1120px; height: 84px; margin: auto; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .brand { font-size: 16px; font-weight: 800; letter-spacing: .08em; }
  nav { display: flex; gap: 28px; font-size: 14px; }
  nav a:hover { color: var(--blue); }
  main { max-width: 1120px; min-height: 520px; margin: auto; padding: 72px 28px; }
  h1 { max-width: 760px; margin: 0 0 24px; font-size: clamp(42px, 7vw, 72px); line-height: 1.04; letter-spacing: -.045em; }
  h2 { margin-top: 48px; font-size: 28px; }
  p { color: var(--muted); line-height: 1.75; }
  .lead { max-width: 680px; font-size: 20px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; }
  .card { min-height: 180px; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
  .card h2 { margin: 0 0 12px; font-size: 20px; }
  .button { display: inline-block; margin-top: 24px; padding: 13px 18px; border-radius: 8px; color: #fff; background: var(--ink); font-size: 14px; }
  footer { max-width: 1120px; margin: auto; padding: 32px 28px 48px; border-top: 1px solid var(--line); }
  footer p { margin: 4px 0; font-size: 13px; }
  @media (max-width: 720px) {
    .header { height: auto; padding: 20px; align-items: flex-start; gap: 16px; }
    nav { flex-wrap: wrap; justify-content: flex-end; gap: 10px 18px; }
    main { padding-top: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
